# Скопируйте этот файл в .env и заполните значения.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=замените-на-длинный-случайный-ключ
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://medease.kg

# Почта (Gmail: нужен «пароль приложения»). Если пусто — письма выводятся в консоль.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
